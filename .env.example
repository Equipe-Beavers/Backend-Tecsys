# Copie para .env somente se ele ainda não existir.
# Use o PostgreSQL local do time; substitua os valores ilustrativos.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geomash
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_local
DB_SSL=false
PORT=3000
API_HOST=0.0.0.0

# Critérios usam PostgreSQL diretamente. Ative somente para trabalhar com
# módulos que não precisam do Supabase. Outros módulos podem depender dele.
DISABLE_SUPABASE=true
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CORS_ORIGINS=http://localhost:8080

# Edificações (Overture Maps, consultadas sob demanda; nada é gravado no banco)
# OVERTURE_RELEASE=2026-09-23.1
BUILDINGS_QUERY_TIMEOUT_MS=120000
BUILDINGS_CACHE_TTL_MIN=1440
BUILDINGS_CACHE_MAX=300000
BUILDING_DEFAULT_FLOORS=2
BUILDINGS_MAX_RADIUS_M=3000
