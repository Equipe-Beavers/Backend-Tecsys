# Copie para .env somente se ele ainda não existir.
# Use a conexão PostgreSQL da AWS fornecida pela equipe.
DB_HOST=seu-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=geomash
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_SSL=true
DB_SSL_MODE=require
PORT=3000
API_HOST=0.0.0.0

# Obrigatória para login JWT. Gere um segredo aleatório de ao menos 32 bytes.
# Exemplo de geração local: openssl rand -hex 32
JWT_SECRET=<defina_um_segredo_aleatorio>

# Envio pelo Gmail: utilize uma senha de app, nunca a senha normal da conta.
EMAIL_PROVIDER=gmail
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=<senha_de_app_sem_espacos>
# Alternativa: EMAIL_PROVIDER=resend. Sem domínio, só envia para o e-mail da conta Resend.
# RESEND_API_KEY=<chave_com_permissao_de_envio>
# EMAIL_FROM=Geomash <onboarding@resend.dev>
# Frontend web local: flutter run -d chrome (porta detectada pelo Origin da requisição).
# Sem Origin (Android nativo), fallback http://127.0.0.1:8080/ ou PASSWORD_RESET_URL.
# Em produção, configure obrigatoriamente a URL HTTPS do FRONTEND.
# PASSWORD_RESET_URL=https://app.seu-dominio.com/
# ANDROID_USB_AUTOCONNECT=false

# Critérios usam PostgreSQL diretamente. Ative somente para trabalhar com
# módulos que não precisam do Supabase. Outros módulos podem depender dele.
DISABLE_SUPABASE=true
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CORS_ORIGINS=http://localhost:8080

# Edificações (Overture Maps, consultadas sob demanda; nada é gravado no banco)
# OVERTURE_RELEASE=2026-09-23.1
BUILDINGS_QUERY_TIMEOUT_MS=120000
BUILDINGS_CACHE_TTL_MIN=1440
BUILDINGS_CACHE_MAX=300000
BUILDING_DEFAULT_FLOORS=2
BUILDINGS_MAX_RADIUS_M=3000
